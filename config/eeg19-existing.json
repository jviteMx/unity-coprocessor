{
  "schema_version": 1,
  "sample_rate_hz": 500,
  "channels": [
    "P7",
    "P4",
    "Cz",
    "Pz",
    "P3",
    "P8",
    "O1",
    "O2",
    "T8",
    "F8",
    "C4",
    "F4",
    "Fp2",
    "Fz",
    "C3",
    "F3",
    "Fp1",
    "T7",
    "F7"
  ],
  "input_unit": "V",
  "reference": {
    "mode": "as_acquired"
  },
  "filter": {
    "low_hz": 1.0,
    "high_hz": 45.0,
    "order": 4,
    "notch_hz": 60.0,
    "notch_q": 30.0,
    "settle_seconds": 2.0
  },
  "ica": {
    "mode": "calibrate_then_freeze",
    "calibration_seconds": 10.0,
    "training_seconds": 20.0,
    "learning_rate": 0.005,
    "rank_tolerance": 0.0001,
    "removal": "frontal_projection",
    "frontal_channels": [
      "Fp1",
      "Fp2"
    ],
    "frontal_fraction_threshold": 0.35,
    "remove_components": []
  },
  "welch": {
    "window_seconds": 4.0,
    "segment_samples": 512,
    "overlap_samples": 256,
    "hop_seconds": 0.5
  },
  "bands": {
    "theta": [
      4.0,
      8.0
    ],
    "alpha": [
      8.0,
      13.0
    ],
    "beta": [
      13.0,
      30.0
    ]
  },
  "ratios": [
    {
      "name": "attention",
      "channels": [
        "Fp1",
        "Fp2"
      ],
      "aggregate": "mean",
      "expression": "beta / theta"
    },
    {
      "name": "engagement",
      "channels": [
        "Cz",
        "C4",
        "C3"
      ],
      "aggregate": "mean",
      "expression": "beta / (alpha + theta)"
    }
  ],
  "quality": {
    "max_abs_uv": 150.0,
    "min_denominator_uv2": 1e-06
  },
  "lsl": {
    "stream_name": "ReplayEEG",
    "allow_missing_labels": false
  },
  "unity": {
    "host": "127.0.0.1",
    "port": 9877
  }
}
